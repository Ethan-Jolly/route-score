# National Rail Data Portal credentials (https://opendata.nationalrail.co.uk/)
# Register, subscribe to the HSP feed, then copy your login here.
# Leave unset to run in demo mode with realistic synthetic data.
HSP_EMAIL=
HSP_PASSWORD=

# Neon (or any) Postgres connection string — stores everything fetched from
# HSP and accumulates history beyond HSP's 1-year window. Needed for live data.
# Provision via Vercel Storage → Neon, or at https://neon.tech
DATABASE_URL=

# Your production URL, so Open Graph image links resolve absolutely.
# e.g. https://routescore.app  (leave unset locally)
NEXT_PUBLIC_SITE_URL=
